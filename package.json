{
  "name": "@sulaimon23/utils",
  "version": "0.0.0-development",
  "description": "Typescript utilities commonly used in apps",
  "scripts": {
    "clean": "rm -rf ./lib",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:markers",
    "build:esm": "tsc -p ./configs/tsconfig.esm.json",
    "build:cjs": "tsc -p ./configs/tsconfig.cjs.json",
    "prepack": "npm run build",
    "test": "mocha",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:markers": "node ./scripts/write-type-markers.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulaimon23/utils.git"
  },
  "keywords": [
    "typescript",
    "utilities"
  ],
  "author": "@sulaimon23",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sulaimon23/utils/issues"
  },
  "homepage": "https://github.com/sulaimon23/utils#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "files": [
    "lib/**/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "types": "./lib/cjs/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "mocha": "^11.0.0",
    "prettier": "^3.1.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
