{
    "compilerOptions": {
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "node16",
        "moduleResolution": "node16",
        "types": [
            "node",
            "mocha"
        ],
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
